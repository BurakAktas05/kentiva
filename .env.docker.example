# Docker Compose ortam değişkenleri
# Kopyalayın: cp .env.docker.example .env.docker

DB_PASSWORD=postgres
DB_PORT=5432
API_PORT=8080
ADMIN_PORT=5173
CITIZEN_PORT=3000

# Üretimde değiştirin: openssl rand -base64 64
JWT_SECRET=docker-dev-jwt-secret-min-32-chars-long!!

APP_SETUP_TOKEN=docker-local-setup
APP_PUBLIC_URL=http://localhost:8080

# Tarayıcıdan API'ye erişim (build-time — localhost kullanın)
VITE_API_BASE=http://localhost:8080/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1
