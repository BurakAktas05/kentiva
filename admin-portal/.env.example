# Backend REST API (includes /api/v1)
# Production required: https://api.your-domain.tld/api/v1
VITE_API_BASE=http://localhost:8080/api/v1

# SockJS URL is derived from the same host (.../ws-belediye)

# Optional public website base used for slug preview
# VITE_PUBLIC_SITE_BASE=https://kentiva.app

# Admin portal's canonical origin. Platform owner login lives at
# /super-admin/login; /platform/login and /owner/login are friendly aliases.
# VITE_ADMIN_PORTAL_BASE_URL=https://panel.kentiva.app

# Citizen app/PWA URL used by pilot growth links
# VITE_CITIZEN_APP_URL=https://app.kentiva.app

# Shared tenant root domain
# VITE_PUBLIC_SITE_ROOT_DOMAIN=kentiva.app

# Optional wildcard root for municipality admin workspaces.
# Example: belediye-adi.panel.kentiva.app
# If omitted, the safe fallback is /municipality/login?tenant=belediye-adi.
# VITE_MUNICIPALITY_PORTAL_ROOT_DOMAIN=panel.kentiva.app

# Reserved subdomains
# VITE_RESERVED_SUBDOMAINS=www,admin,api,app,super-admin,platform
