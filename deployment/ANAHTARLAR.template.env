# =============================================================================
#  Kentiva — Tüm platform anahtarları (ŞABLON)
# =============================================================================
# 1) Bu dosyayı kopyalayın:
#      cp deployment/ANAHTARLAR.template.env deployment/ANAHTARLAR.local.env
# 2) deployment/ANAHTARLAR.local.env içine GERÇEK değerleri yazın.
# 3) ANAHTARLAR.local.env ASLA commit etmeyin (.gitignore'da).
#
# Üretim komutları (PowerShell / Git Bash):
#   JWT_SECRET:      openssl rand -base64 64
#   APP_SETUP_TOKEN: openssl rand -hex 32
#   Firebase Base64: [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
# =============================================================================

# --- URL özeti (deploy sonrası doldurun) ---
# RAILWAY_BACKEND_URL=https://belediyeapp-production.up.railway.app
# VERCEL_ADMIN_URL=https://kentiva-admin.vercel.app
# VERCEL_PUBLIC_URL=https://kentiva.vercel.app
# VERCEL_CITIZEN_URL=https://kentiva-app.vercel.app

# =============================================================================
# RAILWAY — Backend (Spring Boot, repo kökü, Dockerfile)
# Dashboard → Service → Variables
# =============================================================================

# Otomatik (PostgreSQL plugin ekleyince)
# DATABASE_URL=postgresql://user:pass@host:port/railway

# Zorunlu
JWT_SECRET=
APP_SETUP_TOKEN=
APP_PUBLIC_URL=
APP_CORS_ALLOWED_ORIGINS=
APP_CACHE_TYPE=redis
REDIS_URL=

# Sunucu (Railway PORT genelde otomatik; startCommand prod profili kullanır)
PORT=8080

# Depolama — üretimde s3 önerilir (application-prod.properties)
APP_STORAGE_TYPE=s3
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=belediyeapp-media
S3_REGION=auto
S3_PUBLIC_URL=

# Geçici test: yerel disk (kalıcı volume yoksa medya kaybolur)
# Production için kullanmayın.
# APP_STORAGE_TYPE=local
# APP_STORAGE_LOCAL_UPLOAD_DIR=/app/uploads

# Opsiyonel
GEMINI_API_KEY=
FIREBASE_CONFIG_BASE64=
SMS_PROVIDER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=KENTIVA
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MEDIA_GUARD_URL=
MEDIA_GUARD_FAIL_OPEN=false
MEDIA_VALIDATION_FAIL_OPEN=false
MEDIA_ANONYMIZATION_FAIL_OPEN=false
APP_SWAGGER_ENABLED=false
APP_WEBSOCKET_ENABLED=true
APP_EXPORT_MAX_ROWS=10000
APP_PILOT_TRIAL_DAYS=90
APP_SYSTEM_GENERATED_EMAIL_DOMAIN=kentiva.app
LOG_LEVEL_APP=INFO

# =============================================================================
# VERCEL — Admin portal (Root Directory: admin-portal)
# =============================================================================
# VITE_API_BASE=https://RAILWAY_BACKEND_URL/api/v1

# =============================================================================
# VERCEL — Public site (Root Directory: public-site)
# =============================================================================
# VITE_API_BASE=https://RAILWAY_BACKEND_URL/api/v1
# VITE_ADMIN_PORTAL_URL=https://VERCEL_ADMIN_URL
# VITE_SITE_URL=https://VERCEL_PUBLIC_URL
# VITE_CITIZEN_APP_URL=https://VERCEL_CITIZEN_URL
# VITE_DEMO_EMAIL=demo@kentiva.app
# VITE_MONTHLY_PRICE_LABEL=₺9.999
# VITE_PILOT_DURATION_LABEL=3 ay

# =============================================================================
# VERCEL — Vatandaş web (opsiyonel, Root Directory: belediyehattı)
# =============================================================================
# VITE_API_BASE_URL=https://RAILWAY_BACKEND_URL/api/v1

# =============================================================================
# APK / Capacitor — Yerel build (belediyehattı/.env)
# cp belediyehattı/.env.example belediyehattı/.env
# =============================================================================
# VITE_API_BASE_URL=https://RAILWAY_BACKEND_URL/api/v1
# CAPACITOR_DEV_SERVER_URL=   ← ÜRETİM APK'DA BOŞ BIRAKIN

# =============================================================================
# Firebase — Android push (dosya, env değil)
# =============================================================================
# belediyehattı/android/app/google-services.json  ← Firebase Console'dan indirin
# Backend: FIREBASE_CONFIG_BASE64 (yukarıda)

# =============================================================================
# Android imzalama (release APK) — yerel, repo dışı
# =============================================================================
# KEYSTORE_PATH=
# KEYSTORE_PASSWORD=
# KEY_ALIAS=
# KEY_PASSWORD=
