# =============================================================================
#  Kentiva — Platform anahtarları (ŞABLON)
# =============================================================================
# Yayınlayan arkadaş:
#   1) cp deployment/ANAHTARLAR.template.env deployment/ANAHTARLAR.local.env
#   2) Aşağıdaki boş alanları doldur
#   3) API / frontend host Variables'a yapıştır
#   4) ANAHTARLAR.local.env ASLA commit etme
#
# Rehber + maliyet: deployment/YAYINLAMA.md
# Medya (S3/R2/B2): deployment/STORAGE.md
# =============================================================================

# --- Deploy sonrası URL'ler (kendinize not) ---
# API_URL=https://api.kentiva.app
# ADMIN_URL=https://admin.kentiva.app
# PUBLIC_URL=https://www.kentiva.app
# CITIZEN_URL=https://app.kentiva.app

# =============================================================================
# BACKEND API (Railway / Render / Cloud Run / …)
# =============================================================================

JWT_SECRET=
APP_SETUP_TOKEN=
APP_PUBLIC_URL=
# QR takip sayfası kökü (public-site). Örn. https://www.kentiva.app
APP_PUBLIC_SITE_URL=
APP_CORS_ALLOWED_ORIGINS=
APP_CACHE_TYPE=redis
REDIS_URL=

APP_MESSAGING_RABBIT_ENABLED=true
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

PORT=8080
SPRING_PROFILES_ACTIVE=prod

# --- Object storage (S3 uyumlu: AWS S3, R2, B2, Spaces, MinIO) ---
APP_STORAGE_TYPE=s3
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=kentiva-media-prod
S3_REGION=auto
S3_PUBLIC_URL=

# --- SMS (Twilio yok; NetGSM kullanın) ---
SMS_PROVIDER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=KENTIVA

# --- AI / Push / Media Guard ---
GEMINI_API_KEY=
FIREBASE_CONFIG_BASE64=
MEDIA_GUARD_URL=
MEDIA_GUARD_FAIL_OPEN=false
MEDIA_VALIDATION_FAIL_OPEN=false
MEDIA_ANONYMIZATION_FAIL_OPEN=false

APP_SWAGGER_ENABLED=false
APP_WEBSOCKET_ENABLED=true
APP_EXPORT_MAX_ROWS=10000
APP_PILOT_TRIAL_DAYS=90
APP_SYSTEM_GENERATED_EMAIL_DOMAIN=kentiva.app
LOG_LEVEL_APP=INFO

# PostgreSQL: Railway plugin DATABASE_URL genelde otomatik bağlanır

# =============================================================================
# FRONTEND — admin-portal (Vercel / Netlify / Pages / …)
# =============================================================================
# VITE_API_BASE=https://api.kentiva.app/api/v1

# =============================================================================
# FRONTEND — public-site
# =============================================================================
# VITE_API_BASE=https://api.kentiva.app/api/v1
# VITE_ADMIN_PORTAL_URL=https://admin.kentiva.app
# VITE_SITE_URL=https://www.kentiva.app
# VITE_CITIZEN_APP_URL=https://app.kentiva.app
# VITE_DEMO_EMAIL=demo@kentiva.app
# VITE_MONTHLY_PRICE_LABEL=₺9.999
# VITE_PILOT_DURATION_LABEL=90 gün

# =============================================================================
# FRONTEND — belediyehattı (opsiyonel vatandaş web)
# =============================================================================
# VITE_API_BASE_URL=https://api.kentiva.app/api/v1

# =============================================================================
# APK — belediyehattı/.env (yerel release)
# =============================================================================
# VITE_API_BASE_URL=https://api.kentiva.app/api/v1
# CAPACITOR_DEV_SERVER_URL=

# Firebase Android: belediyehattı/android/app/google-services.json
# KEYSTORE_PATH / KEYSTORE_PASSWORD / KEY_ALIAS / KEY_PASSWORD  (repo dışı)
