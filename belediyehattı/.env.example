# Citizen app (Vite) - copy to .env

# Spring Boot API base, must end with /api/v1
# Production required: https://api.your-domain.tld/api/v1
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Shared tenant root domain for municipality subdomains
# VITE_TENANT_ROOT_DOMAIN=kentiva.app

# Reserved subdomains
# VITE_RESERVED_SUBDOMAINS=www,admin,api,app,super-admin,platform

# Optional live-reload URL for physical device or emulator
# CAPACITOR_DEV_SERVER_URL=http://192.168.x.x:3000
