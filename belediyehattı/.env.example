# Vatandaş uygulaması (Vite) — cp .env.example .env

# Spring Boot API (sonunda /api/v1 olmalı)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Web/PWA tenant subdomain kök alanı
# VITE_TENANT_ROOT_DOMAIN=kentiva.app
# Ayrılmış alt alanlar (opsiyonel)
# VITE_RESERVED_SUBDOMAINS=www,admin,api,app,super-admin,platform

# Capacitor canlı yenileme (fiziksel cihaz / emulator)
# CAPACITOR_DEV_SERVER_URL=http://192.168.x.x:3000
