FROM node:22-alpine AS build
WORKDIR /app/belediyehatti
COPY belediyehattı/package.json belediyehattı/package-lock.json ./
RUN npm ci
COPY belediyehattı/ ./
ARG VITE_API_BASE_URL=http://localhost:8080/api/v1
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:alpine
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/belediyehatti/dist /usr/share/nginx/html
EXPOSE 80
