# Railway Variables — örnek şablon
# Bu dosyayı Railway dashboard'a kopyalayın. ASLA gerçek anahtarları commit etmeyin.
# Tam liste: deployment/ANAHTARLAR.template.env — adımlar: deployment/YAYINLAMA.md
# Eski railway.env içindeki anahtarlar sızdıysa hemen rotate edin.

# Veritabanı: PostgreSQL eklendiğinde Railway DATABASE_URL otomatik gelir (postgresql:// → jdbc otomatik).
# DATABASE_URL=postgresql://...

# Dışa aktarma satır limiti (opsiyonel)
# APP_EXPORT_MAX_ROWS=10000

# Redis önbellek ve token iptali (production için zorunlu)
APP_CACHE_TYPE=redis
REDIS_URL=

# İlk süper admin (bir kez): admin portal /setup
# En az 32 karakter önerilir.
APP_SETUP_TOKEN=

JWT_SECRET=
GEMINI_API_KEY=

PORT=8080

APP_PUBLIC_URL=https://your-backend.up.railway.app
# Yalnızca HTTPS origin girin. localhost / http production için geçersizdir.
APP_CORS_ALLOWED_ORIGINS=https://your-admin.vercel.app,https://your-public.vercel.app,https://your-citizen.vercel.app

APP_STORAGE_TYPE=s3
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=belediyeapp-media
S3_REGION=auto
S3_PUBLIC_URL=

# Yerel disk (volume mount) kullanıyorsanız:
# Production için önerilmez; medya kalıcılığı riske girer.
# APP_STORAGE_TYPE=local
# APP_STORAGE_LOCAL_UPLOAD_DIR=/app/uploads
# APP_PUBLIC_URL=https://your-backend.up.railway.app

APP_SWAGGER_ENABLED=false
APP_WEBSOCKET_ENABLED=true
MEDIA_GUARD_FAIL_OPEN=false
MEDIA_VALIDATION_FAIL_OPEN=false
MEDIA_ANONYMIZATION_FAIL_OPEN=false

FIREBASE_CONFIG_BASE64=
SMS_PROVIDER=netgsm
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=KENTIVA
