# ============================================================
#  BelediyeApp — Ortam Değişkenleri (ÖRNEK)
#  Bu dosyayı .env olarak kopyalayıp düzenleyin.
#  Railway'da Variables panelinden ekleyin.
# ============================================================

# --- Veritabanı ---
BELEDIYE_DB_URL=jdbc:postgresql://localhost:5432/belediyeapp
DB_USERNAME=postgres
DB_PASSWORD=your-db-password-here

# --- JWT ---
# ÖNEMLİ: Production'da mutlaka değiştirilmeli!
# Üretmek için: openssl rand -base64 64
JWT_SECRET=change-me-to-a-secure-base64-key

# --- CORS ---
# Virgülle ayırın: https://admin.kentiva.app,https://app.kentiva.app
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Cloudflare R2 / AWS S3 (Dosya Depolama) ---
APP_STORAGE_TYPE=s3
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_NAME=belediyeapp-media
S3_REGION=auto
S3_PUBLIC_URL=https://pub-xxx.r2.dev

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Firebase (Push Notifications) ---
FIREBASE_CONFIG_BASE64=

# --- SMS (Şifre Sıfırlama / OTP) ---
# Provider: none (dev log), netgsm, twilio
SMS_PROVIDER=none
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=KENTIVA
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Swagger (Production'da false) ---
APP_SWAGGER_ENABLED=false

# --- Login Güvenliği ---
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_LOCK_MINUTES=15

# --- Depolama: yerel disk (foto vb.) ---
# APP_STORAGE_TYPE=local
# APP_STORAGE_LOCAL_UPLOAD_DIR=C:/Users/KULLANICI/Desktop/belediyeapp/uploads

# --- Public URL (Railway deploy sonrası) ---
# APP_PUBLIC_URL=https://your-app.up.railway.app

# --- Redis (opsiyonel) ---
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- WebSocket ---
APP_WEBSOCKET_ENABLED=true

# --- Medya doğrulama (opsiyonel) ---
# MEDIA_GUARD_URL=http://localhost:8000
