# ============================================================
#  Kentiva / BelediyeApp — Ortam değişkenleri (ÖRNEK)
#  Kopyalayın:  cp .env.example .env
#  Spring Boot proje kökündeki .env dosyasını otomatik okur.
# ============================================================

# --- Veritabanı ---
BELEDIYE_DB_URL=jdbc:postgresql://localhost:5432/belediyeapp
# Railway: DATABASE_URL otomatik (postgresql:// — uygulama jdbc'ye çevirir)
DB_USERNAME=postgres
DB_PASSWORD=

# --- İlk kurulum (production — bir kez süper admin oluşturmak için) ---
# Üretmek için: openssl rand -hex 32
APP_SETUP_TOKEN=

# --- JWT (zorunlu — dev ve prod) ---
# Üretmek için: openssl rand -base64 64
JWT_SECRET=

# --- Sunucu ---
PORT=8080
APP_PUBLIC_URL=http://localhost:8080

# --- CORS (virgülle ayırın) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# --- Depolama ---
# local | s3
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_UPLOAD_DIR=uploads
# Yerel medya imzalı URL süresi (dakika); S3 modunda presigned GET süresi
APP_MEDIA_SIGNED_URL_EXPIRATION_MINUTES=120

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=belediyeapp-media
S3_REGION=auto
S3_PUBLIC_URL=

# --- AI (Google Gemini — backend) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash (önerilen; gemini-1.5-flash artık 404 dönebilir)
GEMINI_MODEL=gemini-2.5-flash

# --- Firebase push (service account JSON, Base64) ---
FIREBASE_CONFIG_BASE64=

# --- SMS OTP (none | netgsm | twilio) ---
SMS_PROVIDER=none
# Çözülen ihbarlarda vatandaşa SMS (true/false)
SMS_NOTIFY_ON_REPORT_RESOLVED=true
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=KENTIVA
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Medya doğrulama (opsiyonel Python servisi) ---
MEDIA_GUARD_URL=
MEDIA_GUARD_FAIL_OPEN=true

# --- Redis (opsiyonel — APP_CACHE_TYPE=redis) ---
APP_CACHE_TYPE=none
# Railway: REDIS_URL otomatik (redis://…)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- WebSocket ---
APP_WEBSOCKET_ENABLED=true

# --- Swagger (production'da false) ---
APP_SWAGGER_ENABLED=false

# --- Login güvenliği ---
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_LOCK_MINUTES=15

# --- JWT süreleri (ms / gün) ---
APP_SECURITY_JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
APP_SECURITY_JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# --- Log ---
LOG_LEVEL_APP=INFO
