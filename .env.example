# ============================================================
#  Kentiva / BelediyeApp - Environment template
#  Copy to .env and fill real secrets last.
#  Spring Boot reads the root .env file automatically.
# ============================================================

# --- Runtime ---
SPRING_PROFILES_ACTIVE=dev
PORT=8080
APP_PUBLIC_URL=http://localhost:8080

# --- Database ---
# Railway can provide DATABASE_URL automatically.
# You can also use BELEDIYE_DB_URL or DB_URL with DB_USERNAME/DB_PASSWORD.
BELEDIYE_DB_URL=jdbc:postgresql://localhost:5432/belediyeapp
DB_URL=
DB_USERNAME=postgres
DB_PASSWORD=
PGHOST=localhost
PGPORT=5432
PGDATABASE=belediyeapp
PGUSER=postgres
PGPASSWORD=

# --- Initial setup / auth ---
# Generate with: openssl rand -hex 32
APP_SETUP_TOKEN=
# Generate with: openssl rand -base64 64
JWT_SECRET=

# --- CORS / WebSocket ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:5174
# Example production wildcard:
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.kentiva.app
APP_CORS_ALLOWED_ORIGIN_PATTERNS=
APP_WEBSOCKET_ENABLED=true
APP_WEBSOCKET_ALLOWED_ORIGINS=
APP_WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=

# --- Storage ---
# local | s3
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_UPLOAD_DIR=uploads
APP_MEDIA_SIGNED_URL_EXPIRATION_MINUTES=120
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
# Backward-compatible alias if you already use it
S3_BUCKET=
S3_REGION=auto
S3_PUBLIC_URL=

# --- Cache ---
# none | redis
APP_CACHE_TYPE=none
# Railway Redis add-on can provide REDIS_URL automatically.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Durable background processing ---
# Local non-Docker development can leave this false and uses the bounded in-process fallback.
# Production and Docker should run RabbitMQ and set this true.
APP_MESSAGING_RABBIT_ENABLED=false
APP_PRODUCTION_REQUIRE_DURABLE_MESSAGING=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_LISTENER_CONCURRENCY=2
RABBITMQ_LISTENER_MAX_CONCURRENCY=8
RABBITMQ_LISTENER_PREFETCH=4

# --- Capacity and backpressure ---
HIKARI_MAX_POOL=30
HIKARI_MIN_IDLE=5
HIKARI_CONNECTION_TIMEOUT_MS=5000
ASYNC_CORE_POOL_SIZE=6
ASYNC_MAX_POOL_SIZE=16
ASYNC_QUEUE_CAPACITY=5000

# --- Media protection ---
MEDIA_GUARD_URL=
MEDIA_GUARD_FAIL_OPEN=true
MEDIA_VALIDATION_FAIL_OPEN=true
MEDIA_ANONYMIZATION_FAIL_OPEN=true

# --- AI ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Push notifications ---
FIREBASE_CONFIG_BASE64=

# --- SMS ---
# none | netgsm | twilio
SMS_PROVIDER=none
SMS_NOTIFY_ON_REPORT_RESOLVED=true
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=KENTIVA
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Mail ---
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# --- Optional widgets / limits ---
ECZANE_API_KEY=
APP_EXPORT_MAX_ROWS=10000
APP_REPORT_IMPORT_MAX_ROWS=5000
APP_REPORT_IMPORT_BATCH_SIZE=100
APP_NOTIFICATION_BROADCAST_BATCH_SIZE=500
APP_PILOT_TRIAL_DAYS=90
APP_SYSTEM_GENERATED_EMAIL_DOMAIN=kentiva.app
APP_LOGIN_MAX_ATTEMPTS=5
APP_LOGIN_LOCK_MINUTES=15
APP_SECURITY_JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
APP_SECURITY_JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30
LOG_LEVEL_APP=INFO
APP_SWAGGER_ENABLED=false

# --- Production notes ---
# In production set:
# APP_PUBLIC_URL=https://api.your-domain.tld
# APP_STORAGE_TYPE=s3
# APP_CACHE_TYPE=redis
# MEDIA_GUARD_FAIL_OPEN=false
# MEDIA_VALIDATION_FAIL_OPEN=false
# MEDIA_ANONYMIZATION_FAIL_OPEN=false
