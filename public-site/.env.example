# API base used by the public website
# Production required: https://api.your-domain.tld/api/v1
VITE_API_BASE=http://localhost:8080/api/v1

# Legacy alias for backward compatibility
# VITE_PUBLIC_API_BASE=http://localhost:8080/api/v1

# Public website canonical root
# Production recommended
# VITE_SITE_URL=https://kentiva.app

# Shared tenant root domain
# VITE_PUBLIC_SITE_ROOT_DOMAIN=kentiva.app

# Reserved subdomains
# VITE_RESERVED_SUBDOMAINS=www,admin,api,app,super-admin,platform

# Admin portal URL
# Production required
VITE_ADMIN_PORTAL_URL=https://admin.kentiva.app

# Municipality workspace finder. It asks for the portal code.
# VITE_MUNICIPALITY_PORTAL_URL=https://panel.kentiva.app/login

# Direct platform super admin login URL
# VITE_SUPER_ADMIN_PORTAL_URL=https://panel.kentiva.app/super-admin/login

# Citizen app / PWA URL
# VITE_CITIZEN_APP_URL=https://app.kentiva.app

# Sales / marketing copy
VITE_DEMO_EMAIL=demo@kentiva.app
VITE_MONTHLY_PRICE_LABEL=₺9.999
VITE_PILOT_DURATION_LABEL=3 ay
