# Railway Deployment Environment Variables
# These variables should be added to the Railway project dashboard or given to Railway AI.

# Database
# Railway automatically provisions a PostgreSQL database and sets DATABASE_URL, which the app will use.
# Ensure you attach a PostgreSQL database to your Railway project.

# JWT (Must be a secure random string in production)
JWT_SECRET=production-secure-base64-key-here-please-change-me

# Server
PORT=8080

# AI Configuration (Gemini API Key provided by user)
GEMINI_API_KEY=AIzaSyDn0FAfG1HyqPg4aHFbkDIexCPSteFL7no

# CORS & Frontend URLs
# IMPORTANT: Change these to the actual domain of your frontend/admin apps on Vercel/Railway.
APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.vercel.app,https://your-admin-domain.vercel.app

# Storage
# If you use local storage on Railway, uploads will be lost when the app restarts unless you mount a Volume.
# You can mount a Volume in Railway to /app/uploads and set:
APP_STORAGE_TYPE=local
APP_STORAGE_LOCAL_UPLOAD_DIR=/app/uploads
APP_PUBLIC_URL=https://your-backend-railway-domain.up.railway.app

# Swagger UI (Disable in production for security, or keep true for testing)
APP_SWAGGER_ENABLED=true

# Swagger UI (Disable in production for security)
# APP_SWAGGER_ENABLED=false

# WebSocket
APP_WEBSOCKET_ENABLED=true
