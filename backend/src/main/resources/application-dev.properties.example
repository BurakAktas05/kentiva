# ============================================================
#  DEV profili — Yerel geliştirme
#  Seçenek A: cp application-dev.properties.example application-dev.properties
#  Seçenek B: cp .env.example .env (proje kökü — Spring otomatik okur)
# ============================================================

spring.datasource.url=jdbc:postgresql://localhost:5432/belediyeapp
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME

# Base64; üretmek için: openssl rand -base64 64
app.security.jwt.secret=CHANGE_ME_BASE64

# İlk kurulum sayfası (/setup) — yerel test
app.setup.token=dev-local-setup-key

spring.flyway.validate-on-migrate=false
spring.flyway.locations=classpath:db/migration,classpath:db/dev-migration

spring.jpa.hibernate.ddl-auto=update

app.storage.type=local
app.storage.local.upload-dir=uploads
app.websocket.enabled=true

springdoc.swagger-ui.enabled=true
springdoc.api-docs.enabled=true

logging.level.com.burak.belediyeapp=DEBUG
spring.jpa.show-sql=true

# Mobil Vite (LAN IP / 127.0.0.1) — tarayici dogrudan API'ye giderse
app.cors.allowed-origin-patterns=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*,http://10.*.*.*:*

# Opsiyonel — AI / SMS / Firebase / widget (.env ile de verilebilir)
# Nöbetçi eczane — ücretsiz plan: https://eczaneapi.com/dashboard (ayda ~200 istek)
# Anahtarsız yedek: eczaneler.gen.tr scrape (otomatik)
# ECZANE_API_KEY=your-key-here
# GEMINI_API_KEY=   # kök .env — Google AI Studio
# GEMINI_MODEL=gemini-2.5-flash
# app.sms.provider=none
# app.firebase.config-base64=
